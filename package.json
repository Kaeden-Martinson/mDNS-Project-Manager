{
  "name": "mdns-project-dashboard",
  "version": "2.0.0",
  "description": "Local mDNS dashboard to register, launch and reverse-proxy your dev projects at <name>.local",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node -e \"require('./src/app')\""
  },
  "keywords": ["mdns", "local", "dashboard", "projects", "reverse-proxy"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "find-process": "^1.4.7",
    "http-proxy": "^1.18.1",
    "multicast-dns": "^7.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
